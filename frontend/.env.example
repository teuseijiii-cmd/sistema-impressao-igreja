
ARQUIVO: 5. frontend/.env.example<br/>
CAMINHO: frontend/.env.example<br/>
DESCRIÇÃO: Exemplo de variáveis de ambiente do frontend

# Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# Backend API
VITE_API_URL=http://localhost:3000/api

# Google OAuth (para login com Google)
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Impressão (para envio direto ao servidor)
VITE_PRINTER_ENDPOINT=http://localhost:3000/api/printer/print
